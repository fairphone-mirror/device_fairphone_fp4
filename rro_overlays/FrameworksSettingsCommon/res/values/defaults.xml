<resources>

    <!-- Default for Settings.System.VIBRATE_WHEN_RINGING -->
    <bool name="def_vibrate_when_ringing">true</bool>

    <!-- Default screen brightness, from 0 to 255.  102 is 40%. -->
    <integer name="def_screen_brightness">128</integer>
    <bool name="def_screen_brightness_automatic_mode">true</bool>

    <!-- Default for Settings.System.TIME_12_24 -->
    <string name="def_time_format" translatable="false">24</string>

    <!-- Default for Settings.Global.WIFI_SCAN_ALWAYS_AVAILABLE -->
    <integer name="def_wifi_scan_always_available">1</integer>

    <integer name="def_screen_off_timeout">30000</integer>

    <!-- Default for Settings.Global.DEVICE_NAME $1=MODEL-->
    <string name="def_device_name_simple">Fairphone 4 5G</string>
</resources>
